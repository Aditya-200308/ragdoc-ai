# ============================================================
# .env.example — Template for your secret keys
# ============================================================
# HOW TO USE:
#   1. Make a COPY of this file
#   2. Rename the copy to exactly:  .env   (no ".example")
#   3. Replace "your_key_here" with your actual Gemini API key
#   4. NEVER share your .env file or push it to GitHub
#
# WHY A .env FILE?
#   Hardcoding API keys in Python files is dangerous.
#   If you push that to GitHub, anyone can see your key and
#   use it (costing you money or getting your account banned).
#   .env files stay on YOUR machine only.
# ============================================================

GEMINI_API_KEY=your_gemini_api_key_here
